chroma_db/
data/uploads/
data/chroma/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
tests/
evaluation/report*.json
docker-compose.yml
.dockerignore
Dockerfile
