# ---------------------------------------------------------------------------
# LLM provider -----------------------------------------------------------
#   openai      -> real grounded answers (requires OPENAI_API_KEY)
#   extractive  -> offline non-LLM baseline that copies context sentences.
#                  Useful for tests and keyless smoke runs; it is NOT an LLM
#                  and its answers must not be reported as model quality.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=60
# Set for an OpenAI-compatible gateway, e.g. http://localhost:11434/v1
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Embeddings (local by default: no API key needed for ingestion) -----------
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave empty to auto-detect. Set to "cpu" to force CPU inference.
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Vector store (persistent on disk) ---------------------------------------
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION=enterprise_documents

# ---------------------------------------------------------------------------
# Chunking and retrieval --------------------------------------------------
#   chunk_size / chunk_overlap are counted in words, not model tokens.
# ---------------------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
# Optional minimum cosine similarity, e.g. 0.25. Chunks below the threshold
# are discarded, and an empty result yields a "not found" answer.
# Leave empty to disable.
SIMILARITY_THRESHOLD=

# ---------------------------------------------------------------------------
# Service ----------------------------------------------------------------
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LLM_MAX_CONTEXT_CHARS=12000

# ---------------------------------------------------------------------------
# Uploads and security ----------------------------------------------------
# ---------------------------------------------------------------------------
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf
